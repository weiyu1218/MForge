{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moleculeforge.io/schemas/cig.schema.json",
  "title": "ChemicalIntentGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "intent_id", "version", "target_context", "objective_nodes", "source_user_input"],
  "properties": {
    "@context": {
      "type": "object",
      "required": ["mf"],
      "additionalProperties": { "type": "string" },
      "properties": {
        "mf": { "const": "https://moleculeforge.io/ontology#" },
        "intent_id": { "const": "mf:intentId" },
        "target_context": { "const": "mf:targetContext" },
        "objective_nodes": { "const": "mf:objectiveNodes" },
        "edges": { "const": "mf:objectiveEdges" },
        "hyperedges": { "const": "mf:objectiveHyperedges" },
        "generative_priors": { "const": "mf:generativePriors" },
        "budget_constraints": { "const": "mf:budgetConstraints" },
        "source_user_input": { "const": "mf:sourceUserInput" }
      }
    },
    "intent_id": { "type": "string" },
    "version": { "type": "string", "default": "2.0" },
    "signature": { "type": ["string", "null"] },
    "target_context": {
      "type": "object",
      "properties": {
        "pocket_embedding": { "type": "array", "items": { "type": "number" } },
        "pdb_ids": { "type": "array", "items": { "type": "string" } },
        "uniprot_ids": { "type": "array", "items": { "type": "string" } },
        "binding_mode_prior": { "type": ["string", "null"] }
      }
    },
    "objective_nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "oracle", "weight"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": [
            "continuous_maximize",
            "continuous_minimize",
            "ratio_maximize",
            "multi_constraint_satisfy"
          ]},
          "oracle": { "type": "string" },
          "target_value": { "type": ["number", "null"] },
          "uncertainty_tolerance": { "type": "number", "default": 0.5 },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "pareto_tier": { "enum": [1, 2, 3], "default": 2 },
          "soft_penalty": { "type": "boolean", "default": false }
        }
      }
    },
    "edges": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["source_id", "target_id", "relation", "strength"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string" },
          "target_id": { "type": "string" },
          "relation": { "type": "string" },
          "strength": { "type": "number", "minimum": -1, "maximum": 1 }
        }
      }
    },
    "hyperedges": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["source_ids", "target_ids", "relation", "strength"],
        "additionalProperties": false,
        "properties": {
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "target_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "relation": { "type": "string" },
          "strength": { "type": "number", "minimum": -1, "maximum": 1 }
        }
      }
    },
    "generative_priors": {
      "type": "object",
      "properties": {
        "scaffold_bias": { "type": ["string", "null"] },
        "mw_range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "ring_systems": { "type": "array", "items": { "type": "string" } },
        "forbidden_substructures": { "type": "array", "items": { "type": "string" } },
        "novelty_vs_analogy": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.5 }
      }
    },
    "budget_constraints": {
      "type": "object",
      "properties": {
        "oracle_L2_calls_max": { "type": "integer", "default": 5000 },
        "oracle_L3_calls_max": { "type": "integer", "default": 200 },
        "oracle_L4_calls_max": { "type": "integer", "default": 20 },
        "wallclock_hours": { "type": "number", "default": 12 },
        "cost_usd_max": { "type": ["number", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": ["string", "null"] },
    "source_user_input": { "type": "string" }
  }
}
