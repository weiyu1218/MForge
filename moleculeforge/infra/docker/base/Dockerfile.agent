FROM moleculeforge/base:latest

LABEL description="MoleculeForge agent runtime"

ENV UV_PROJECT_ENVIRONMENT=/opt/agent-runtime

WORKDIR /workspace

COPY pyproject.toml uv.lock ./
COPY libs ./libs
COPY models ./models
COPY services ./services
COPY agents ./agents
COPY pipelines ./pipelines

RUN uv sync \
    --frozen \
    --no-dev \
    --extra agent-runtime \
    --no-editable

WORKDIR /app

ENV PATH="/opt/agent-runtime/bin:$PATH"
