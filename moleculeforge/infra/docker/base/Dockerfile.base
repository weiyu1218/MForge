FROM nvidia/cuda:13.0.2-cudnn-runtime-ubuntu22.04

LABEL maintainer="MoleculeForge"
LABEL description="Base image: CUDA 13.0 + Python 3.12 + uv"

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    curl \
    ca-certificates \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir "uv==0.11.32" && \
    uv python install 3.12.13 && \
    uv venv --python 3.12.13 --seed /opt/venv

ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /app
